{
  "name": "dsh-unslop",
  "version": "0.1.0",
  "type": "module",
  "description": "unslop for DeepSeek Harness: a standalone MCP server that turns vibecoded, AI-looking UI into a designed interface, bridged into dsh as mcp__unslop__* tools plus a workflow skill. Vendored under CC BY 4.0.",
  "license": "MIT",
  "author": "YG",
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "unslop",
    "ui",
    "design",
    "mcp"
  ],
  "exports": {
    ".": "./host/index.js",
    "./client": "./client.js",
    "./mcp": "./mcp/server.mjs",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "host/index.js",
    "host/mcp-client.js",
    "host/http-util.js",
    "client.js",
    "mcp/server.mjs",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "icon.svg",
    "skills/unslop/SKILL.md",
    "skills/unslop/references/*.md",
    "skills/unslop/scripts/*.mjs",
    "tests/smoke.mjs",
    "tests/hosttest.mjs",
    "tests/routetest.mjs",
    "README.md",
    "LICENSE",
    "LICENSE-unslop-CC-BY-4.0.txt",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node tests/smoke.mjs && node tests/hosttest.mjs && node tests/routetest.mjs"
  }
}
